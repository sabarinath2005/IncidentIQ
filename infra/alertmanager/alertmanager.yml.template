global:
  resolve_timeout: 5m
route:
  receiver: incidentiq-webhook
  group_by: [alertname, service_name]
  group_wait: 5s
  group_interval: 30s
  repeat_interval: 30m
receivers:
  - name: incidentiq-webhook
    webhook_configs:
      - url: http://api:8000/api/v1/webhooks/alertmanager/__INTEGRATION_ID__
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials_file: /run/secrets/alertmanager_webhook_token
